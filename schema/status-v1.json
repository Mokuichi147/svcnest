{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "svcnest v1 status and list output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "services"],
  "properties": {
    "schema_version": {"const": 1},
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "command", "resolved_executable", "cwd", "enabled", "restart", "uptime_seconds", "state", "pid", "started_at", "restarts", "last_exit_code", "last_exit_signal", "reason"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "description": {"type": "string"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resolved_executable": {"type": "string"},
        "cwd": {"type": "string"},
        "enabled": {"type": "boolean"},
        "restart": {"enum": ["never", "on-failure", "always"]},
        "uptime_seconds": {"type": ["integer", "null"], "minimum": 0},
        "state": {"enum": ["starting", "running", "stopping", "stopped", "backoff", "failed", "foreground", "unavailable"]},
        "pid": {"type": ["integer", "null"], "minimum": 1},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "restarts": {"type": "integer", "minimum": 0},
        "last_exit_code": {"type": ["integer", "null"]},
        "last_exit_signal": {"type": ["integer", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
